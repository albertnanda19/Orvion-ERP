{
  "dashboard": {
    "title": "Orvion Finance Service",
    "editable": true,
    "tags": ["orvion", "erp", "finance"],
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 39,
    "panels": [
      {
        "id": 1,
        "title": "Invoices Created / hour",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus" },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{job=~\"orvion-finance.*\",uri=\"/invoices\"}[1h]))",
            "legendFormat": "Invoices/hr",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cph",
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        }
      },
      {
        "id": 2,
        "title": "Payments Processed",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "datasource": { "type": "prometheus" },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{job=~\"orvion-finance.*\",uri=\"/payments\"}[1h]))",
            "legendFormat": "Payments/hr",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cph",
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        }
      },
      {
        "id": 3,
        "title": "Journal Entries Posted / day",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "datasource": { "type": "prometheus" },
        "targets": [
          {
            "expr": "sum(increase(http_server_requests_seconds_count{job=~\"orvion-finance.*\",uri=\"/journal\"}[24h]))",
            "legendFormat": "Journal Entries",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        }
      },
      {
        "id": 4,
        "title": "Outstanding Invoice Amount",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "datasource": { "type": "prometheus" },
        "targets": [
          {
            "expr": "sum(orvion_finance_outstanding_invoice_amount{job=~\"orvion-finance.*\"})",
            "legendFormat": "Outstanding",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 50000 },
                { "color": "red", "value": 100000 }
              ]
            },
            "min": 0,
            "max": 200000
          },
          "overrides": []
        }
      },
      {
        "id": 5,
        "title": "JVM Heap Usage",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "datasource": { "type": "prometheus" },
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{job=~\"orvion-finance.*\",area=\"heap\"}",
            "legendFormat": "Used",
            "refId": "A"
          },
          {
            "expr": "jvm_memory_max_bytes{job=~\"orvion-finance.*\",area=\"heap\"}",
            "legendFormat": "Max",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "fillOpacity": 20
            }
          },
          "overrides": []
        }
      },
      {
        "id": 6,
        "title": "GC Pause Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "datasource": { "type": "prometheus" },
        "targets": [
          {
            "expr": "rate(jvm_gc_pause_seconds_sum{job=~\"orvion-finance.*\"}[1m])",
            "legendFormat": "GC Pause",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never"
            }
          },
          "overrides": []
        }
      }
    ]
  },
  "overwrite": true,
  "inputs": []
}
